{
  "name": "@tiebreak/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file ../.env.local src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env.local dist/index.js",
    "lint": "eslint .",
    "db:generate": "node --env-file ../.env.local node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file ../.env.local node_modules/.bin/drizzle-kit migrate",
    "db:studio": "node --env-file ../.env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "tsx --env-file ../.env.local src/db/seed.ts",
    "test:smoke": "tsx --env-file ../.env.local scripts/smoke-test.ts"
  },
  "dependencies": {
    "@tiebreak/shared": "0.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "morgan": "^1.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
