# Copy this to .env.local at the repo root and fill in real values.
# `neon init --agent` / `neon deploy` (see neon.ts) writes .env.local for you
# from your actual Neon project — this file just documents what's expected.

NODE_ENV=development

# Postgres — pooled for app traffic, unpooled (direct) for migrations only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

NEON_BRANCH=production

# Neon Auth (managed Better Auth) — both are public URLs, safe in the client
# bundle. BASE_URL is what the browser calls directly to sign in/up/out;
# JWKS_URL is what the server verifies incoming session tokens against.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# The deployed client's origin, for the server's CORS allow-list in
# production (see server/src/app.ts). Not read in development — the Vite
# dev proxy makes client/server calls same-origin instead.
CLIENT_ORIGIN=

# yarn test:smoke (server/scripts/smoke-test.ts) — a throwaway Neon Auth
# account, created automatically on first run if it doesn't exist yet. Any
# email/password works; pick something you won't mind seeing in the Neon
# Auth user list.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
# Defaults to the live deployment; override to point at localhost:3000/api
# for a local run instead.
SMOKE_TEST_API_BASE=
